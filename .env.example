# Sanruth ERP Environment Configuration Template
# Copy this file to .env and configure your actual environment credentials

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=sunder_billing

# Meta WhatsApp Cloud API Configuration
META_PHONE_NUMBER_ID=your_meta_phone_number_id
META_ACCESS_TOKEN=your_meta_permanent_system_user_token
ADMIN_WHATSAPP_NUMBER=your_admin_whatsapp_number_with_country_code
META_API_VERSION=v20.0
